---
interface Props {
  variant?: 'primary' | 'secondary' | 'solid' | 'ghost' | 'onDark';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  full?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [k: string]: any;
}
const { variant = 'primary', size = 'md', href, full = false, type = 'button', class: cls = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---
<Tag href={href} type={href ? undefined : type} class:list={['btn', `btn-${variant}`, `btn-${size}`, { 'btn-full': full }, cls]} {...rest}><slot /></Tag>

<style is:global>
  .btn { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2, 8px); box-sizing: border-box;
    font-family: var(--font-sans); font-weight: 600; text-transform: uppercase; text-decoration: none; white-space: nowrap;
    border: 1px solid; border-radius: var(--radius-sm, 2px); cursor: pointer;
    transition: background 140ms var(--ease-standard), color 140ms var(--ease-standard), border-color 140ms var(--ease-standard), transform 80ms var(--ease-standard); }
  .btn:active { transform: scale(var(--press-scale, 0.98)); }
  .btn-full { width: 100%; }
  .btn-sm { padding: 8px 16px; font-size: 13px; letter-spacing: .06em; min-height: 36px; }
  .btn-md { padding: 12px 24px; font-size: 14px; letter-spacing: .07em; min-height: 46px; }
  .btn-lg { padding: 16px 34px; font-size: 15px; letter-spacing: .08em; min-height: 56px; }
  .btn-primary { background: var(--brand-ochre); color: var(--text-on-accent); border-color: var(--brand-ochre); }
  .btn-primary:hover { background: var(--ochre-600); color: var(--brand-parchment); border-color: var(--ochre-600); }
  .btn-secondary { background: transparent; color: var(--brand-espresso); border-color: var(--border-strong); }
  .btn-secondary:hover { background: var(--neutral-200); border-color: var(--brand-espresso); color: var(--brand-espresso); }
  .btn-solid { background: var(--brand-espresso); color: var(--brand-parchment); border-color: var(--brand-espresso); }
  .btn-solid:hover { background: var(--neutral-800); border-color: var(--neutral-800); color: var(--brand-parchment); }
  .btn-ghost { background: transparent; color: var(--ochre-600); border-color: transparent; }
  .btn-ghost:hover { background: var(--ochre-100); color: var(--ochre-700); }
  .btn-onDark { background: transparent; color: var(--brand-parchment); border-color: var(--border-dark); }
  .btn-onDark:hover { background: rgba(245,237,225,.10); border-color: var(--brand-parchment); color: var(--brand-parchment); }
  .btn .arrow { display: inline-flex; transition: transform 240ms var(--ease-out); }
  .btn:hover .arrow { transform: translateX(4px); }
</style>
