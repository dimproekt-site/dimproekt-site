---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Badge from './Badge.astro';

interface Spec { k: string; v: string }
interface Props {
  href: string;
  title: string;
  image: ImageMetadata;
  stageLabel?: string;
  forSale?: boolean;
  location?: string;
  description?: string;
  specs?: Spec[];
  badgeLabel?: string;
  lazy?: boolean;
}
const { href, title, image, stageLabel, forSale, location, description, specs = [], badgeLabel = 'Для продажу', lazy = true } = Astro.props;
---
<a href={href} class="pc" data-zoom-card>
  <div class="pc-photo">
    <Image src={image} alt={title} widths={[360, 560, 720]} sizes="(max-width: 700px) 100vw, 360px" loading={lazy ? 'lazy' : 'eager'} class="pc-img" data-zoom-img />
    {forSale && <div class="pc-badge"><Badge tone="accent">{badgeLabel}</Badge></div>}
  </div>
  <div class="pc-body">
    {stageLabel && <div class="pc-stage">{stageLabel}</div>}
    <h3 class="pc-title">{title}</h3>
    {location && <div class="pc-loc">{location}</div>}
    {description && <p class="pc-desc">{description}</p>}
    {specs.length > 0 && (
      <dl class="pc-specs">
        {specs.map((s) => (
          <div><dt>{s.k}</dt><dd>{s.v}</dd></div>
        ))}
      </dl>
    )}
  </div>
</a>

<style>
  .pc { display: flex; flex-direction: column; height: 100%; box-sizing: border-box; text-decoration: none; color: inherit; background: var(--surface-card);
    border: 1px solid var(--border-hairline); border-radius: 4px; overflow: hidden; box-shadow: var(--shadow-1);
    transition: box-shadow 240ms var(--ease-standard), transform 240ms var(--ease-standard), border-color 240ms var(--ease-standard); }
  .pc:hover { box-shadow: var(--shadow-3); transform: translateY(-2px); border-color: var(--border-strong); color: inherit; }
  .pc-photo { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--neutral-200); flex: 0 0 auto; }
  .pc-photo :global(.pc-img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out); }
  .pc:hover .pc-photo :global(.pc-img) { transform: scale(1.05); }
  .pc-badge { position: absolute; top: 16px; left: 16px; pointer-events: none; }
  .pc-body { flex: 1 1 auto; display: flex; flex-direction: column; padding: 20px 20px 24px; }
  .pc-stage { margin-bottom: 12px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; font-weight: 600; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pc-title { margin: 0; font-family: var(--font-display); font-size: 26px; line-height: 1.2; font-weight: 500; color: var(--text-heading); text-wrap: balance; }
  .pc-loc { margin-top: 8px; font-size: 13px; color: var(--text-muted); }
  .pc-desc { margin: 16px 0 0; font-size: 15px; line-height: 1.6; color: var(--text-body); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pc-specs { margin: auto 0 0; padding-top: 20px; display: flex; flex-wrap: wrap; gap: 16px 24px; }
  .pc-specs > div { }
  .pc-specs { border-top: 0; }
  .pc-specs::before { content: ''; flex-basis: 100%; height: 0; border-top: 1px solid var(--border-hairline); margin-bottom: -4px; }
  dt { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: var(--text-muted); }
  dd { margin: 4px 0 0; font-family: var(--font-display); font-size: 21px; line-height: 1.2; color: var(--text-heading); }
  @media (prefers-reduced-motion: reduce) { .pc, .pc-photo :global(.pc-img) { transition: none; } }
</style>
