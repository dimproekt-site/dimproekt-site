---
import { GLYPHS } from './icons';
interface Props { name: string; size?: number; strokeWidth?: number; label?: string; class?: string }
const { name, size = 20, strokeWidth = 2, label, class: cls } = Astro.props;
const glyph = GLYPHS[name];
if (!glyph) console.warn(`[Icon] невідома іконка: ${name}`);
---
{glyph && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none"
    stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round"
    role={label ? 'img' : 'presentation'} aria-label={label} aria-hidden={label ? undefined : 'true'}
    class={cls} style="display:inline-block;flex:0 0 auto" set:html={glyph} />
)}
