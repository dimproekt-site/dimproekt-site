  .lb-l { left: 16px; } .lb-r { right: 16px; }
  @media (max-width: 768px) { .ph-in { padding: 32px 20px 32px; } .ph .pi-eyebrow { margin-top: 36px; } .ph-intro { font-size: 19px; } .gt { width: 84px; } .incl-in, .pager, .sim, .pcta { padding-left: 20px; padding-right: 20px; } .incl-in { padding-top: 56px; padding-bottom: 56px; } .pager, .sim { padding-top: 64px; } .pcta { padding-top: 64px; padding-bottom: 64px; } .pg-t { font-size: 22px; } .ord { padding: 22px; } }
</style>

<script>
  // Галерея, лайтбокс (фото й плани), клавіші ← →, свайп
  const data = JSON.parse(document.getElementById('lb-data')!.textContent || '{}') as { gal: { src: string; alt: string }[]; plan: { src: string; alt: string }[] };
  const slides = [...document.querySelectorAll<HTMLElement>('.gs')];
  const thumbs = [...document.querySelectorAll<HTMLElement>('.gt')];
  const count = document.querySelector<HTMLElement>('[data-gcount]');
  const prevB = document.querySelector<HTMLElement>('[data-gprev]'), nextB = document.querySelector<HTMLElement>('[data-gnext]');
  const n = slides.length;
  let gi = 0;
  const showG = (k: number) => {
    gi = Math.max(0, Math.min(n - 1, k));
    slides.forEach((s, i) => (s.hidden = i !== gi));
    thumbs.forEach((t, i) => t.classList.toggle('on', i === gi));
    if (count) count.textContent = `${gi + 1} / ${n}`;
    if (prevB) prevB.hidden = gi === 0;
    if (nextB) nextB.hidden = gi === n - 1;
    const t = thumbs[gi], box = t?.parentElement;
    if (t && box) { const l = t.offsetLeft - box.offsetLeft, r = l + t.offsetWidth; if (l < box.scrollLeft) box.scrollLeft = l - 8; else if (r > box.scrollLeft + box.clientWidth) box.scrollLeft = r - box.clientWidth + 8; }
  };
  if (n > 1) {
    showG(0);
    prevB?.addEventListener('click', () => showG(gi - 1));
    nextB?.addEventListener('click', () => showG(gi + 1));
    document.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => showG(+b.dataset.pick!)));
    const gal = document.querySelector<HTMLElement>('[data-gal]')!;
    gal.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') { e.preventDefault(); showG(gi - 1); } else if (e.key === 'ArrowRight') { e.preventDefault(); showG(gi + 1); } });
    let sx = 0, sy = 0;
    const main = document.querySelector('[data-gmain]')!;
    main.addEventListener('touchstart', (e: any) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    main.addEventListener('touchend', (e: any) => { const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy; if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) showG(gi + (dx < 0 ? 1 : -1)); }, { passive: true });
    const th = document.querySelector<HTMLElement>('[data-thumbs]');
    th?.addEventListener('wheel', (e) => { if (th.scrollWidth <= th.clientWidth || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; e.preventDefault(); th.scrollLeft += e.deltaY; }, { passive: false });
  }

  const lb = document.getElementById('lightbox') as HTMLDialogElement;
  const img = lb.querySelector<HTMLImageElement>('[data-lbimg]')!, cnt = lb.querySelector<HTMLElement>('[data-lbcount]')!;
  let kind: 'gal' | 'plan' = 'gal', li = 0;
  const pad = (x: number) => String(x).padStart(2, '0');
  const paint = () => { const arr = data[kind]; const it = arr[li]; img.src = it.src; img.alt = it.alt; cnt.textContent = `${pad(li + 1)} / ${pad(arr.length)}`; };
  const openLb = (k: 'gal' | 'plan', i: number) => { kind = k; li = i; paint(); lb.showModal(); document.body.style.overflow = 'hidden'; };
  const step = (d: number) => { const len = data[kind].length; li = (li + d + len) % len; paint(); };
  lb.addEventListener('close', () => { document.body.style.overflow = ''; });
  lb.querySelector('[data-lbclose]')!.addEventListener('click', () => lb.close());
  lb.querySelector('[data-lbprev]')!.addEventListener('click', () => step(-1));
  lb.querySelector('[data-lbnext]')!.addEventListener('click', () => step(1));
  lb.addEventListener('mousedown', (e) => { if (e.target === lb || (e.target as Element).classList.contains('lb-stage')) lb.close(); });
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') step(-1); else if (e.key === 'ArrowRight') step(1); });
  let tx = 0, ty = 0;
  lb.addEventListener('touchstart', (e) => { tx = e.touches[0].clientX; ty = e.touches[0].clientY; }, { passive: true });
  lb.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - tx, dy = e.changedTouches[0].clientY - ty; if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1); }, { passive: true });
  document.querySelector('[data-gopen]')?.addEventListener('click', () => openLb('gal', gi));
  document.querySelectorAll<HTMLElement>('[data-plopen]').forEach((b) => b.addEventListener('click', () => openLb('plan', +b.dataset.plopen!)));
</script>
