  .cp summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 0; font-size: 15px; font-weight: 600; color: var(--text-heading); }
  .cp summary::-webkit-details-marker { display: none; } .cp summary:hover { color: var(--ochre-600); }
  .cp-ic { display: flex; transition: transform 240ms var(--ease-standard); } .cp[open] .cp-ic { transform: rotate(90deg); }
