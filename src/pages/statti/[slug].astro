---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Badge from '../../components/Badge.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import { CONTACTS, ROUTES } from '../../i18n/site';
import { getArticles } from '../../lib/projects';
import { abs, breadcrumbs, ORG_ID } from '../../lib/seo';

export async function getStaticPaths() {
  const all = await getArticles();
  return all.map((e) => ({ params: { slug: e.id }, props: { entry: e, others: all.filter((x) => x.id !== e.id).slice(0, 2) } }));
}
const { entry, others } = Astro.props as any;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h: any) => h.depth === 2);
const fmt = (x: Date) => x.toLocaleDateString('uk-UA', { day: '2-digit', month: '2-digit', year: 'numeric' });
const iso = (x: Date) => x.toISOString().slice(0, 10);
const site = Astro.site!;
const og = await getImage({ src: d.cover, width: 1200, height: 630, format: 'jpeg', fit: 'cover' });
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: d.title, description: d.seo_description, inLanguage: 'uk',
    image: abs(og.src, site), datePublished: d.date.toISOString(), dateModified: d.date.toISOString(),
    mainEntityOfPage: abs(Astro.url.pathname, site),
    author: { '@id': abs(ORG_ID, site) }, publisher: { '@id': abs(ORG_ID, site) },
  },
  breadcrumbs([{ name: 'Головна', path: '/' }, { name: 'Статті', path: '/statti/' }, { name: d.title }], site),
];
---
<Layout title={`${d.seo_title} | ДІМПРОЕКТ`} description={d.seo_description} image={og.src} ogType="article" jsonLd={ld} uaOnly enHref={ROUTES.homeEn}>
  <div class="prog" aria-hidden="true"><div data-prog></div></div>
  <article class="ar" data-art>
    <header data-screen-label="Верх статті">
      <Breadcrumbs items={[{ label: 'Головна', href: ROUTES.home }, { label: 'Статті', href: ROUTES.articles }, { label: d.title }]} />
      <div class="ar-meta"><Badge tone="accent">{d.rubric}</Badge><span><time datetime={iso(d.date)}>{fmt(d.date)}</time>&nbsp;·&nbsp;{d.read_time} хв читання</span></div>
      <h1 class="ar-h1">{d.title}</h1>
      <div class="ar-cover"><Image src={d.cover} alt={d.cover_alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1200px) 100vw, 1136px" loading="eager" class="ar-cimg" /></div>
    </header>
    <div class:list={['ar-grid', { notoc: toc.length < 3 }]}>
      {toc.length >= 3 && (
        <aside class="toc-aside"><nav class="toc" aria-label="Зміст статті">
          <div class="toc-t">Зміст</div>
          <div class="toc-l">
            {toc.map((h: any) => (<a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>))}
          </div>
        </nav></aside>
      )}
      <div class="art-body"><Content /></div>
    </div>

    <section class="ar-cta" data-screen-label="Консультація">
      <h2>Обговоримо ваш будинок?</h2>
      <p>Розкажіть про ділянку та побажання — підберемо матеріали й конструкції під ваш проект.</p>
      <div class="ar-cta-b">
        <Button variant="primary" size="lg" data-consult-open data-consult-message={`Питання після статті «${d.title}»`}>Отримати консультацію</Button>
        <a class="ar-ph" href={CONTACTS.phoneHref}>{CONTACTS.phone}</a>
      </div>
    </section>

    {others.length > 0 && (
      <section class="ar-rel" data-screen-label="Читайте також">
        <h2>Читайте також</h2>
        <div class="ar-rel-g">
          {others.map((a: any) => (
            <a class="al-card" href={`/statti/${a.id}/`}>
              <Image src={a.data.cover} alt={a.data.cover_alt} widths={[360, 640, 960]} sizes="(max-width: 700px) 100vw, 380px" loading="lazy" class="al-cimg" />
              <div class="al-cb">
                <div class="al-meta"><Badge tone="accent">{a.data.rubric}</Badge><span><time datetime={iso(a.data.date)}>{fmt(a.data.date)}</time>&nbsp;·&nbsp;{a.data.read_time} хв читання</span></div>
                <h3 class="al-ct">{a.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style is:global>
  .prog { position: fixed; top: 0; left: 0; right: 0; height: 3px; z-index: 200; pointer-events: none; }
  .prog > div { height: 100%; background: var(--brand-ochre); transform-origin: left; transform: scaleX(0); }
  .ar { width: 100%; max-width: 1200px; margin: 0 auto; padding: 48px clamp(16px, 4vw, 32px) 96px; box-sizing: border-box; }
  .ar-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 48px; font-size: 13px; color: var(--text-muted); }
  .ar-meta span:last-child { white-space: nowrap; }
  .ar-h1 { margin: 20px 0 0; font-family: var(--font-display); font-weight: 400; font-size: clamp(32px, 6.4vw, 56px); line-height: 1.1; letter-spacing: -.01em; color: var(--text-heading); max-width: 24ch; text-wrap: balance; }
  .ar-cover { margin-top: 40px; aspect-ratio: 16 / 9; background: #fff; border: 1px solid var(--border-hairline); border-radius: 4px; overflow: hidden; position: relative; }
  .ar-cimg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block; }
  .ar-grid { display: grid; grid-template-columns: minmax(0, 1fr); justify-content: center; gap: 48px; margin-top: 48px; align-items: start; }
  @media (min-width: 1024px) { .ar-grid { grid-template-columns: 240px minmax(0, 68ch); gap: 64px; } .ar-grid.notoc { grid-template-columns: minmax(0, 68ch); } }
  .toc-aside { align-self: stretch; }
  @media (max-width: 1023px) { .toc-aside { display: none; } }
  .toc { position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow-y: auto; overscroll-behavior: contain; padding-top: 6px; box-sizing: border-box; }
  .toc-t { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; color: #4A3927; }
  .toc-l { margin-top: 16px; display: flex; flex-direction: column; border-left: 1px solid var(--border-hairline); }
  .toc-l a { display: block; margin-left: -1px; padding: 7px 0 7px 16px; border-left: 2px solid transparent; font-size: 14px; line-height: 1.4; color: var(--text-muted); text-decoration: none; transition: color 140ms, border-color 140ms; }
  .toc-l a:hover { color: var(--text-heading); }
  .toc-l a.on { border-left-color: var(--brand-ochre); color: var(--text-heading); font-weight: 600; }

  .art-body { min-width: 0; max-width: 68ch; }
  .art-body > p:first-child { margin: 0; font-size: 21px; line-height: 1.6; color: var(--text-heading); text-wrap: pretty; }
  .art-body p { margin: 20px 0 0; font-size: 17px; line-height: 1.75; color: var(--text-body); text-wrap: pretty; }
  .art-body a { color: var(--ochre-600); text-underline-offset: 3px; }
  .art-body a:hover { color: var(--brand-espresso); }
  .art-body h2 { scroll-margin-top: 32px; margin: 72px 0 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 4.4vw, 40px); line-height: 1.15; color: var(--text-heading); text-wrap: balance; }
  .art-body h3 { margin: 40px 0 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(22px, 3vw, 26px); line-height: 1.25; color: var(--text-heading); }
  .art-body h2 + p, .art-body h3 + p { margin-top: 16px; }
  .art-body img { display: block; width: 100%; height: auto; margin-top: 32px; border: 1px solid var(--border-hairline); border-radius: 4px; box-sizing: border-box; }
  .art-body img[src*="/logo-"], .art-body img[src*="/uteplyuvach-brend-"] { width: auto; max-width: 100%; max-height: 56px; border: 0; margin-top: 28px; }
  .art-body strong { color: var(--text-heading); font-weight: 600; }
  .art-body ul, .art-body ol { margin: 24px 0 0; padding: 0; list-style: none; counter-reset: s; }
  .art-body li { position: relative; padding: 12px 0 12px 36px; border-top: 1px solid var(--border-hairline); font-size: 17px; line-height: 1.6; color: var(--text-body); }
  .art-body li:last-child { border-bottom: 1px solid var(--border-hairline); }
  .art-body ul li::before { content: ''; position: absolute; left: 4px; top: 24px; width: 6px; height: 6px; background: var(--brand-ochre); }
  .art-body ol > li { counter-increment: s; }
  .art-body ol > li::before { content: counter(s); position: absolute; left: 0; top: 11px; width: 24px; height: 24px; border: 1px solid var(--border-strong); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-size: 14px; color: var(--text-heading); }
  .art-body blockquote { margin: 28px 0 0; padding: 4px 0 4px clamp(20px, 3vw, 28px); border-left: 2px solid var(--brand-ochre); }
  .art-body blockquote p { margin: 8px 0 0; font-family: var(--font-display); font-size: 24px; line-height: 1.4; color: var(--text-heading); }
  .art-body blockquote p:first-child { margin-top: 0; }
  .art-body table { display: block; overflow-x: auto; width: 100%; margin-top: 28px; border-collapse: collapse; font-size: 15px; }
  .art-body th { padding: 12px 10px; text-align: center; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; font-weight: 600; color: var(--ochre-600); border-bottom: 1px solid var(--border-strong); }
  .art-body th:first-child, .art-body td:first-child { text-align: left; padding-left: 0; }
  .art-body td { padding: 12px 10px; text-align: center; border-bottom: 1px solid var(--border-hairline); color: var(--text-heading); }
  .art-body th:nth-child(2) { background: var(--ochre-100); border-bottom: 2px solid var(--brand-ochre); }
  .art-body td:nth-child(2) { background: var(--ochre-100); }
  .art-body .table-wrap, .art-body table { max-width: 100%; }

  .ar-cta { margin-top: 96px; padding-top: 48px; border-top: 1px solid var(--border-hairline); max-width: 68ch; margin-left: auto; margin-right: auto; }
  .ar-cta h2 { margin: 0; font-family: var(--font-display); font-weight: 500; font-size: clamp(28px, 4vw, 40px); line-height: 1.15; color: var(--text-heading); }
  .ar-cta p { margin: 16px 0 0; font-size: 17px; line-height: 1.6; color: var(--text-body); }
  .ar-cta-b { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 28px; }
  .ar-ph { font-family: var(--font-display); font-size: 28px; color: var(--text-heading); text-decoration: none; } .ar-ph:hover { color: var(--ochre-600); }
  .ar-rel { margin-top: 96px; }
  .ar-rel h2 { margin: 0 0 32px; font-family: var(--font-display); font-weight: 500; font-size: 34px; color: var(--text-heading); }
  .ar-rel-g { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 32px; }
</style>
<script>
  // Індикатор читання і підсвічування розділу в змісті
  const art = document.querySelector<HTMLElement>('[data-art]')!;
  const bar = document.querySelector<HTMLElement>('[data-prog]')!;
  const links = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
  const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
  const tick = () => {
    const r = art.getBoundingClientRect(), total = r.height - innerHeight;
    bar.style.transform = `scaleX(${total > 0 ? Math.max(0, Math.min(1, -r.top / total)) : 0})`;
    let a = -1; heads.forEach((h, k) => { if (h.getBoundingClientRect().top < innerHeight * 0.35) a = k; });
    links.forEach((l, k) => l.classList.toggle('on', k === a));
  };
  let raf = 0;
  addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; tick(); }); }, { passive: true });
  addEventListener('resize', tick); tick();
</script>
