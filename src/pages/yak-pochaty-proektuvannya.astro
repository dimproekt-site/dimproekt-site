</style>
<script>
  const axes = document.querySelector<HTMLElement>('[data-axes]');
  const secs = ['stages', 'engineer', 'permits', 'start'].map((id) => document.getElementById(id));
  if (axes && secs.every(Boolean)) {
    const btns = [...axes.querySelectorAll<HTMLElement>('.ax')];
    const spy = () => {
      const vh = innerHeight; let a = 0;
      secs.forEach((e, k) => { if (e!.getBoundingClientRect().top < vh * 0.45) a = k; });
      const on = secs[0]!.getBoundingClientRect().top < vh * 0.6 && secs[3]!.getBoundingClientRect().bottom > vh * 0.4;
      axes.classList.toggle('show', on);
      btns.forEach((b, k) => { b.classList.toggle('on', k === a); b.setAttribute('aria-current', String(k === a)); });
    };
    let raf = 0;
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; spy(); }); }, { passive: true });
    spy();
    btns.forEach((b) => b.addEventListener('click', () => {
      const el = document.getElementById(b.dataset.go!);
      if (el) scrollTo({ top: el.getBoundingClientRect().top + scrollY, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }));
  }
</script>
