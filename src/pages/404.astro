---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { ROUTES } from '../i18n/site';
---
<Layout title="Сторінку не знайдено | ДІМПРОЕКТ" noindex uaOnly>
  <section class="nf" data-screen-label="404">
    <img class="nf-mark" src="/assets/mark-dark.svg" alt="" />
    <div class="nf-in" data-reveal>
      <div class="nf-code">404</div>
      <div class="nf-line" data-draw="x"></div>
      <h1>Сторінку не знайдено</h1>
      <p>Можливо, посилання застаріло або в адресі є помилка. Перегляньте проекти або напишіть нам.</p>
      <div class="nf-btns">
        <Button variant="primary" size="lg" href={ROUTES.sadybni}>Дивитись проекти</Button>
        <Button variant="secondary" size="lg" href={ROUTES.multi}>Багатоквартирне житло та комерційна нерухомість</Button>
        <Button variant="ghost" size="lg" data-consult-open>Отримати консультацію</Button>
      </div>
    </div>
  </section>
</Layout>
<style>
  .nf { position: relative; overflow: hidden; display: grid; place-items: center; padding: 96px 32px 120px; min-height: 60vh; }
  .nf-mark { position: absolute; left: 50%; top: 50%; width: min(900px, 120vw); transform: translate(-50%, -50%); opacity: .06; pointer-events: none; }
  .nf-in { position: relative; max-width: 720px; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .nf-code { font-family: var(--font-display); font-size: clamp(120px, 22vw, 220px); line-height: .9; letter-spacing: -.02em; color: var(--brand-ochre); }
  .nf-line { margin-top: 24px; width: 80px; height: 2px; background: var(--brand-ochre); }
  h1 { margin: 32px 0 0; font-family: var(--font-display); font-weight: 500; font-size: 44px; line-height: 1.15; color: var(--text-heading); }
  p { margin: 16px 0 0; font-size: 17px; line-height: 1.6; max-width: 46ch; text-wrap: pretty; }
  .nf-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 16px; margin-top: 40px; }
  @media (max-width: 768px) { .nf { padding: 64px 20px 80px; } h1 { font-size: 32px; } }
</style>
