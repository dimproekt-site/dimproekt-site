---
import Layout from '../layouts/Layout.astro';
import LegalPage from '../components/LegalPage.astro';
import { ROUTES } from '../i18n/site';

// Дату змінити на день підключення домену dimproekt.com (офіційний запуск сайту)
const updated = '[дата запуску сайту]';
const raw: [string, string][] = [
  ['Хто збирає дані', 'ТОВАРИСТВО З ОБМЕЖЕНОЮ ВІДПОВІДАЛЬНІСТЮ «АРХІТЕКТУРНА МАЙСТЕРНЯ «ДІМПРОЕКТ» (ТОВ «Архітектурна майстерня «Дімпроект»), e-mail: dimproekt.am@gmail.com.'],
  ['Які дані ми збираємо', "Коли ви надсилаєте форму: ім'я, телефон або контакт у месенджері, текст повідомлення. Якщо ви пишете нам у месенджері чи на пошту, ми отримуємо дані, які ви самі вказали. Сайт не використовує cookies для відстеження. Для статистики відвідувань застосовується Cloudflare Web Analytics, який працює без cookies і не ідентифікує окремих відвідувачів."],
  ['Навіщо', "Щоб зв'язатися з вами щодо проектування, відповісти на запитання та підготувати пропозицію."],
  ['Кому передаємо', 'Дані не продаються і не передаються третім особам для реклами. Сайт працює на інфраструктурі Cloudflare, а повідомлення з форми надходять нам через сервіс Telegram. Якщо ви самі пишете нам у WhatsApp (Meta) або Telegram, листування обробляється цими сервісами за їхніми правилами; через сайт воно не проходить. Дані також можуть бути передані, якщо цього вимагає закон.'],
  ['Скільки зберігаємо', 'Звернення з форми сайту (ім\'я, контакт, текст повідомлення) видаляємо не пізніше ніж через 3 місяці після останнього повідомлення, якщо воно не привело до замовлення. Якщо ви замовили проект, договір і документи про оплату зберігаємо протягом строків, установлених законодавством (щонайменше 3 роки). Ви можете попросити видалити звернення раніше, написавши нам на пошту.'],
  ['Ваші права', 'Ви можете запитати, які дані ми зберігаємо, виправити їх, вимагати видалення або відкликати згоду, написавши на нашу пошту. Ми виконуємо такі запити незалежно від країни проживання.'],
  ['Зміни', 'Ми можемо оновлювати цей текст, актуальну дату вказано вгорі.'],
];
const sections = raw.map(([title, t]) => ({ title, body: [t] }));
---
<Layout title="Політика конфіденційності | ДІМПРОЕКТ" description="Які дані збирає сайт ДІМПРОЕКТ, навіщо, кому передаються і як довго зберігаються." uaOnly enHref={ROUTES.homeEn}>
  <LegalPage crumbs={[{ label: 'Головна', href: ROUTES.home }, { label: 'Політика конфіденційності' }]} title="Політика конфіденційності" tocLabel="Зміст" updatedLabel="Оновлено" updated={updated} sections={sections} />
</Layout>
