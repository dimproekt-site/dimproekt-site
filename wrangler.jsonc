{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dimproekt",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  // Сайт відкривається лише через dimproekt.com: адреси *.workers.dev не вмикаємо
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
}
